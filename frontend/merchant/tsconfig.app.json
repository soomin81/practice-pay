{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* shadcn/ui가 생성하는 코드가 `@/lib/utils` 형태로 import한다.
       루트 tsconfig.json에도 같은 별칭을 둔다(shadcn CLI가 그쪽을 읽는다).

       shadcn 문서는 `baseUrl`을 함께 두라고 하지만 TypeScript 6에서 deprecated라
       빌드가 에러로 막힌다(TS5101). TS 6부터는 paths가 tsconfig 위치를 기준으로
       해석되므로 baseUrl 없이 그대로 동작한다. */
    "paths": {
      "@/*": ["./src/*"]
    },

    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
