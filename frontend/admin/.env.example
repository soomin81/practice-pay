# 이 파일을 .env.local로 복사해서 쓴다(.env.local은 gitignore 대상).
#
#   cp .env.example .env.local

# 내부 운영자 콘솔 API 주소(api-admin).
VITE_API_BASE_URL=http://localhost:8082

# **가맹점 콘솔의 주소다 — 이 앱의 주소가 아니다.**
#
# 가맹점을 등록하면 최초 OWNER의 초대 Token이 나오는데, 그 사람이 계정을 활성화할 곳은
# 내부 운영자 콘솔이 아니라 가맹점 콘솔(frontend/merchant)의 /accept-invitation이다.
# 그래서 merchant 콘솔처럼 window.location.origin을 쓸 수 없고 이 값이 필요하다.
# 운영에서 콘솔 도메인이 갈리면 여기만 바꾸면 된다.
VITE_MERCHANT_CONSOLE_URL=http://localhost:5174
