# 이 파일을 .env.local로 복사해서 쓴다(.env.local은 gitignore 대상).
#
#   cp .env.example .env.local

# 결제 API 주소. 기본값과 같으므로 보통 비워둬도 된다.
VITE_API_BASE_URL=http://localhost:8081

# 개발 모드의 "테스트 결제 생성" 버튼이 쓰는 가맹점 API Key다.
# 아래 값은 backend/db-core/.../db/seed/seed_dev_identity_data.sql이 심는
# 로컬 개발 전용 키라 저장소에 이미 평문으로 있다 — 운영 키를 여기 넣지 않는다.
# 이 값이 없으면 버튼이 비활성화되고 안내만 뜬다(프로덕션 빌드에는 아예 포함되지 않는다).
VITE_DEV_API_KEY=sk_test_devkey01_dev-secret-value

# 테스트 결제가 USDC를 받을 지갑 주소 — **본인이 통제하는 주소를 직접 넣어야 한다.**
#
# 원래 가맹점이 결제를 만들 때 지정하는 값이라 기본값이 있을 수 없다. 그래서 값이
# 없으면 버튼이 비활성화된다 — 기본값을 두면 그 주소로 실제 테스트넷 USDC가 전송된다.
#
# MetaMask에서 두 번째 계정을 만들어 그 주소를 넣는 것을 권한다(보내는 계정과 받는
# 계정이 달라야 실제 흐름과 같아진다). 절차는 docs/guides/testnet-wallet-setup.md 참고.
#
# 주의: 토큰 Contract 주소(0x036CbD…CF7e)를 넣지 않는다. 그건 "USDC라는 토큰"의
# 주소이지 사람의 지갑이 아니고, 그리로 보낸 토큰은 되찾을 수 없다.
VITE_DEV_RECEIVING_WALLET=
