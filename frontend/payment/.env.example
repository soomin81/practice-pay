# 이 파일을 .env.local로 복사해서 쓴다(.env.local은 gitignore 대상).
#
#   cp .env.example .env.local

# 결제 API 주소. 기본값과 같으므로 보통 비워둬도 된다.
VITE_API_BASE_URL=http://localhost:8081

# 개발 모드의 "테스트 결제 생성" 버튼이 쓰는 가맹점 API Key다.
# 아래 값은 backend/db-core/.../db/seed/seed_dev_identity_data.sql이 심는
# 로컬 개발 전용 키라 저장소에 이미 평문으로 있다 — 운영 키를 여기 넣지 않는다.
# 이 값이 없으면 버튼이 비활성화되고 안내만 뜬다(프로덕션 빌드에는 아예 포함되지 않는다).
VITE_DEV_API_KEY=sk_test_devkey01_dev-secret-value
